{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-auth",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AUTH_IN_DEV=1",
        "npm",
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3101"
      ],
      "port": 3101
    }
  ]
}