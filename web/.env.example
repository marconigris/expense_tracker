# Local: postgres://<user>@localhost:5432/finanzas  ·  Production: Neon URL (set by the Vercel integration)
DATABASE_URL=

# Sign-in (email + password). Locally sign-in is skipped unless AUTH_IN_DEV=1.
AUTH_SECRET=

# Optional: path to the Codex CLI if it is neither on PATH nor in /Applications/Codex.app
CODEX_BIN=
