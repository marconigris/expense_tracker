{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "codex:classify": "tsx --env-file=.env --env-file-if-exists=.env.prod scripts/codex-classify.ts",
    "codex:pdf": "tsx --env-file=.env --env-file-if-exists=.env.prod scripts/codex-pdf.ts",
    "vercel-build": "drizzle-kit migrate && tsx scripts/seed.ts && next build",
    "set-password": "tsx --env-file=.env --env-file-if-exists=.env.prod scripts/set-password.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
